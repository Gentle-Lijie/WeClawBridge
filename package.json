{
  "name": "weclaw-bridge",
  "version": "0.2.6",
  "description": "Standalone cross-platform bridge for the WeChat ClawBot (iLink) protocol — bind and forward instructions without installing openclaw.",
  "icon": "https://cdn.jsdelivr.net/gh/Gentle-Lijie/WeClawBridge@main/assets/icon.png",
  "license": "MIT",
  "type": "module",
  "author": "LijieZhou",
  "homepage": "https://github.com/Gentle-Lijie/WeClawBridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gentle-Lijie/WeClawBridge.git"
  },
  "bugs": {
    "url": "https://github.com/Gentle-Lijie/WeClawBridge/issues"
  },
  "keywords": [
    "wechat",
    "weixin",
    "clawbot",
    "openclaw",
    "ilink",
    "bridge",
    "webhook",
    "tencent"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "files": [
    "dist",
    "bin",
    "skill",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "weclaw": "bin/weclaw.mjs"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node bin/weclaw.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "node bin/postinstall.mjs || echo ''",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
